+# Caipora local patch: Lichess can send gameStart twice for the same game; a second play_game
+# then fails on the game stream (HTTP 429) and can take the game down with it.
+started_games: set[str] = set()
+
+
 def start_game_thread(active_games: dict[str, str], game_id: str, opponent_name: str,
                       play_game_args: PlayGameArgsType, pool: POOL_TYPE) -> None:
     """Start a game thread."""
+    if game_id in started_games:
+        logger.info(f"--- Ignoring repeated gameStart for {game_id}")
+        return
+    started_games.add(game_id)
     active_games[game_id] = opponent_name
     log_proc_count("Used", active_games)
     play_game_args["game_id"] = game_id
